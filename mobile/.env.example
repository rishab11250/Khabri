# Base HTTPS URL of the deployed Khabri backend API without a trailing slash (required in prod; dev falls back to localhost).
EXPO_PUBLIC_API_URL=

# Supabase project URL used by the mobile Auth SDK (required for sign-in/sign-up; public client config).
EXPO_PUBLIC_SUPABASE_URL=

# Supabase publishable anon key safe for bundling into the Expo app (required for sign-in/sign-up; public anon key).
EXPO_PUBLIC_SUPABASE_ANON_KEY=
