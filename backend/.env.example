# --- Server ---
# TCP port the Express API binds to locally or behind Render's proxy (optional, default 4000).
PORT=4000
# Runtime environment: development | test | production (optional, default development).
NODE_ENV=development
# Comma-separated or single allowed browser origin; unset allows all origins for mobile clients.
# CORS_ORIGIN=

# --- Database ---
# MongoDB Atlas connection URI (required, SECRET). Get from Atlas -> Connect -> Drivers.
MONGODB_URI=

# --- Authentication (Supabase Auth) ---
# Supabase project HTTPS URL (required, public identifier). Get from Project Settings -> API.
SUPABASE_URL=
# Service-role key used solely for account deletion on DELETE /v1/me (optional, HIGHLY SECRET).
SUPABASE_SERVICE_ROLE_KEY=
# Legacy HS256 JWT secret used only if your Supabase project signs HS256 tokens (optional, SECRET).
SUPABASE_JWT_SECRET=
# Explicit JWKS endpoint override (optional; defaults to <SUPABASE_URL>/auth/v1/.well-known/jwks.json).
SUPABASE_JWKS_URL=

# --- Web Search Fallback (SerpAPI) ---
# Primary & secondary SerpAPI keys (optional, SECRET). Get from https://serpapi.com/manage-api-key.
SERPAPI_KEY_1=
SERPAPI_KEY_2=
# Monthly call quota per SerpAPI key; keys rotate at 90% and stop at 95% total (optional, default 0 = disabled).
SERPAPI_MONTHLY_LIMIT_PER_KEY=

# --- AI Summarization, Vision, & Ask (Gemini + Groq) ---
# Primary (background ticks) & secondary (interactive user flows) Gemini keys (optional, SECRET). Get from AI Studio.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
# Gemini model identifier (optional, for example gemini-2.5-flash).
GEMINI_MODEL=
# Primary & secondary Groq fallback API keys & model name (optional, SECRET). Get from console.groq.com.
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_MODEL=
# Daily request cap per AI key before router fails over (optional, 0 disables quota tracking).
AI_DAILY_LIMIT_PER_KEY=

# --- Push Notifications & Background Jobs ---
# Expo Push access token for authenticated push delivery in production (optional, SECRET).
EXPO_ACCESS_TOKEN=
# Shared secret required in `x-tick-secret` header for POST /internal/tick and /internal/digest (required, min 8 chars, SECRET).
INTERNAL_TICK_SECRET=
# Enables mutating the built-in Demo Notice Board via POST /demo/board (optional, default false).
DEMO_MODE=true
